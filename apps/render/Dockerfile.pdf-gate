# ============================================================================
#  The PDF gate's tools, on top of the REAL render image. Test only, never
#  deployed: built by tests/docs-render/pdf-gate.sh from the image that
#  apps/render/Dockerfile produced, so the gate tests exactly what ships.
#
#  A separate file on purpose: a stage added at the end of the main
#  Dockerfile would become its default build target, and compose would ship
#  these tools to production.
#
#  From Alpine 3.24's own signed repository, as the image's own packages are:
#    poppler-utils   pdftotext, pdffonts    the text check (0011's proof)
#    harfbuzz-utils  hb-shape              the reference shaping
#    mupdf-tools     mutool trace/extract  the glyphs the PDF draws
#    py3-fonttools                         glyph outlines, to compare them
#    strace                                every file Typst opens
# ============================================================================
ARG RENDER_IMAGE
FROM ${RENDER_IMAGE}
USER root
RUN apk add --no-cache poppler-utils harfbuzz-utils mupdf-tools py3-fonttools strace
USER node
