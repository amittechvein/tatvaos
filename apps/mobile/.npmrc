# ============================================================================
#  Flat node_modules, on purpose.
# ============================================================================
#
#  pnpm's default layout puts every package inside node_modules/.pnpm/ under a
#  directory named after all of its peer dependencies. That is excellent for
#  correctness and fatal on Windows for anything that compiles native code:
#  expo-modules-core's own folder name is 108 characters before Gradle adds
#  build/intermediates/cxx/Debug/<hash>/logs/x86_64/ underneath it, which took
#  the path to 273 against Windows' 260-character limit. The build failed with
#  "cannot find the file specified" about a file it had just written.
#
#  hoisted gives the flat, npm-shaped node_modules the Android toolchain
#  expects, and drops that same path to 153 characters.
#
#  This is still pnpm. apps/mobile has its own pnpm-lock.yaml because it is
#  excluded from the workspace (see pnpm-workspace.yaml for why) — one package
#  manager, two projects. Do not add package-lock.json back.

node-linker=hoisted
