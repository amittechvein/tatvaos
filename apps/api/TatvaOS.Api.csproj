<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TatvaOS.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Nullable warnings as errors: a null tenant id must not compile -->
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!--
      Pinned to patch CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc, CVSS 7.5).

      Microsoft.AspNetCore.OpenApi pulls in Microsoft.OpenApi 2.0.0
      transitively. Versions from 2.0.0-preview11 to 2.7.5 crash the process
      via stack overflow when parsing a document with circular schema
      references. Fixed in 2.7.5.

      A transitive dependency cannot be upgraded in place, so it is declared
      explicitly here to override the resolved version. Remove this line once
      Microsoft.AspNetCore.OpenApi ships a version that pulls 2.7.5+ itself.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!--
      DNS lookups for domain verification. System.Net.Dns resolves A and PTR
      records only — it cannot ask for TXT or MX, which is exactly what proving
      domain ownership requires.
    -->
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <!--
      MIME parsing and composition. MimeKit reads what Dovecot stored so the
      ingest worker can index it; MailKit submits what the webmail composes
      through our own Postfix :587, where the verified-domain outbound gate
      applies. System.Net.Mail.SmtpClient is not used for user mail — it is
      deprecated by Microsoft's own docs and cannot produce a message we could
      also store as the canonical raw copy.
    -->
    <!--
      4.17.0 minimum. NuGet audit (correctly) fails the build below that:
      MimeKit ≤ 4.15.0 has a CRLF injection via quoted local-parts
      (GHSA-g7hc-96xr-gvvx) — SMTP command injection through a crafted
      address, which for a mail product is the whole ballgame — and
      MailKit ≤ 4.12.0 has STARTTLS response injection (GHSA-9j88-vvj5-vhgr).
      Fixed in MimeKit 4.15.1 and MailKit 4.16.0 respectively.
    -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
  </ItemGroup>

</Project>
