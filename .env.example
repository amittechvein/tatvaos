# Copy to .env and fill in. NEVER commit .env.
#
# WHERE THIS FILE'S SECRETS ACTUALLY LIVE: the box's .env is copied VERBATIM
# into every nightly backup (backup.sh) — deliberately, because a backup that
# cannot bring the box back is theatre. A secret's real blast radius therefore
# includes every backup of this file, wherever those are kept. Treat backup
# storage with the same care as the box itself.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://tatvaos_app:dev_app_pw@localhost:5432/tatvaos_mail
MAILEDGE_DATABASE_URL=postgresql://tatvaos_mailedge:dev_mail_pw@localhost:5432/tatvaos_mail

# --- Cache ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage -------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=tatvaos-mail-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail edge ------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=5870
IMAP_HOST=localhost
IMAP_PORT=1143

# --- Outbound relay (production). Empty locally — Mailpit catches everything.
RELAY_HOST=
RELAY_USER=
RELAY_PASSWORD=

# --- Auth -----------------------------------------------------------------
JWT_SIGNING_KEY=change-me-in-every-environment
JWT_ISSUER=https://api.tatvaos.local
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Push (Phase 2) -------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_PATH=
FCM_SERVICE_ACCOUNT_JSON=

# --- Third party ----------------------------------------------------------
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Connect: private (encrypted) meetings --------------------------------
# The secret the per-meeting media key is derived from. Unset means Private
# meetings are switched OFF on this server; Recorded meetings are unaffected.
# Must be long and random — anything under 32 characters is IGNORED, because
# a weak key here looks like encryption without being it.
#
#   Linux/Mac:  openssl rand -base64 48
#   Windows:    $rng = New-Object System.Security.Cryptography.RNGCryptoServiceProvider; $b = New-Object byte[] 48; $rng.GetBytes($b); [Convert]::ToBase64String($b)
#
# A GOOD value looks like scrambled nonsense with ~40 different characters.
# If a generator prints mostly ONE repeated character (e.g. all 'A's), the
# randomness step FAILED and it printed an empty buffer — do not use it. The
# server refuses such values anyway and says so in the log.
#
# ROTATING THIS HAS A CONSEQUENCE, AND IT IS NOT A SURPRISE:
# every meeting's key is derived from it, so anyone who JOINS OR REJOINS a
# private meeting after a rotation derives the new key and will see and hear
# nothing from the people already in the room. It clears when that meeting
# ends. Rotate BETWEEN meetings, never during one.
#
# AND WHERE THIS SECRET LIVES: this file, and every nightly backup of it
# (see the note at the top). "Derived, not stored" is true of the per-meeting
# keys, NOT of this value — the security of Private meetings rides on backup
# security. Rotation does not remove old values from old backups. The safe
# way to set it writes it straight to its destination, so no terminal or
# shell history ever holds it:
#
#   printf 'CONNECT_ROOM_KEY_SECRET=%s\n' "$(openssl rand -base64 48)" >> infra/docker/.env
#
# Distinct from JWT_SIGNING_KEY on purpose: one secret per purpose, so
# rotating or leaking one does not touch the other.
CONNECT_ROOM_KEY_SECRET=

# ----------------------------------------------------------------------------
#  AI (mail writing, meeting notes) — apps/api/Shared/Ai
# ----------------------------------------------------------------------------
#  UNSET IS FINE. Leave these blank and every AI feature reports itself
#  unavailable in words; nothing else changes. Set them and the same features
#  switch on with no deploy-time ceremony.
#
#  AI_BASE_URL is the swap point. OpenAI direct today:
#      https://api.openai.com/v1
#  Azure OpenAI in an India region later — same code, ~10% more, data stays
#  in India, which is what institutional customers ask about first.
#
#  AI_MODEL must be a name the ACCOUNT actually has. Ask it, do not trust an
#  article — on 21 Aug 2026 a published pricing page named models this
#  account's own list did not show. To ask:
#      KEY=$(grep '^AI_API_KEY=' infra/docker/.env | cut -d= -f2-)
#      curl -s https://api.openai.com/v1/models -H "Authorization: Bearer $KEY" \
#        | tr ',' '\n' | grep '"id"' | cut -d'"' -f4 | sort
#      unset KEY
#
#  gpt-5.6-luna is a MOVING name: no dated variant exists, so the provider can
#  change what sits behind it. Watch output quality; the model is a setting.
#
#  SETTING THE KEY WITHOUT IT TOUCHING A SCREEN, A CLIPBOARD OR A CHAT:
#      grep -q '^AI_API_KEY=' infra/docker/.env && echo "already present" || {
#        read -rsp 'Paste the key, then Enter: ' K
#        printf 'AI_API_KEY=%s\n' "$K" >> infra/docker/.env; unset K; echo; }
#
#  A command whose OUTPUT is a secret is unsafe by construction; one that
#  writes it straight to its destination is safe by construction.
#
#  AFTERWARDS, PROVE IT ANSWERS rather than assuming it is set:
#      GET /api/admin/ai/status  (SuperAdmin) — a real round trip, and it
#      checks the model FOLLOWED the instruction, not merely that bytes came
#      back. Configured and working are different words.
# ----------------------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
