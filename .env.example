# Copy to .env and fill in. NEVER commit .env.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://tatvaos_app:dev_app_pw@localhost:5432/tatvaos_mail
MAILEDGE_DATABASE_URL=postgresql://tatvaos_mailedge:dev_mail_pw@localhost:5432/tatvaos_mail

# --- Cache ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage -------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=tatvaos-mail-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail edge ------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=5870
IMAP_HOST=localhost
IMAP_PORT=1143

# --- Outbound relay (production). Empty locally — Mailpit catches everything.
RELAY_HOST=
RELAY_USER=
RELAY_PASSWORD=

# --- Auth -----------------------------------------------------------------
JWT_SIGNING_KEY=change-me-in-every-environment
JWT_ISSUER=https://api.tatvaos.local
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Push (Phase 2) -------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_PATH=
FCM_SERVICE_ACCOUNT_JSON=

# --- Third party ----------------------------------------------------------
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Connect: private (encrypted) meetings --------------------------------
# The secret the per-meeting media key is derived from. Unset means Private
# meetings are switched OFF on this server; Recorded meetings are unaffected.
# Must be long and random — anything under 32 characters is IGNORED, because
# a weak key here looks like encryption without being it.
#
#   openssl rand -base64 48
#
# ROTATING THIS HAS A CONSEQUENCE, AND IT IS NOT A SURPRISE:
# every meeting's key is derived from it, so anyone who JOINS OR REJOINS a
# private meeting after a rotation derives the new key and will see and hear
# nothing from the people already in the room. It clears when that meeting
# ends. Rotate BETWEEN meetings, never during one.
#
# Distinct from JWT_SIGNING_KEY on purpose: one secret per purpose, so
# rotating or leaking one does not touch the other.
CONNECT_ROOM_KEY_SECRET=
