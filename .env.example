# Copy to .env and fill in. NEVER commit .env.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://tatvaos_app:dev_app_pw@localhost:5432/tatvaos_mail
MAILEDGE_DATABASE_URL=postgresql://tatvaos_mailedge:dev_mail_pw@localhost:5432/tatvaos_mail

# --- Cache ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage -------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=tatvaos-mail-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail edge ------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=5870
IMAP_HOST=localhost
IMAP_PORT=1143

# --- Outbound relay (production). Empty locally — Mailpit catches everything.
RELAY_HOST=
RELAY_USER=
RELAY_PASSWORD=

# --- Auth -----------------------------------------------------------------
JWT_SIGNING_KEY=change-me-in-every-environment
JWT_ISSUER=https://api.tatvaos.local
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Push (Phase 2) -------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_PATH=
FCM_SERVICE_ACCOUNT_JSON=

# --- Third party ----------------------------------------------------------
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
