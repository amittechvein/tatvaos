# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/
bin/
obj/
*.user

# TypeScript incremental build state. Machine-local, regenerated on every
# typecheck, and a merge conflict every time two people run tsc.
*.tsbuildinfo

# Turborepo local task cache. Compressed build artifacts keyed by a hash of
# the inputs - regenerated on demand and meaningless on another machine.
# Committing them bloats the repo with binaries that change on every build.
.turbo/
**/.turbo/

# Expo
.expo/
*.ipa
*.apk
*.aab

# Environment — never commit secrets
.env
.env.local
.env.*.local
!.env.example

# Mail edge secrets
# DKIM private keys - committing one means rotating every domain that uses it
infra/dkim/*.key
infra/dkim/*.private
**/dkim/*.key
infra/**/dkim/*.key
infra/**/*.pem
!infra/**/*.example.pem

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Local stack data
local/data/
local/**/vmail/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Raw brand source art (served copies live in apps/web/public/brand)
/Logo/

# env backups - any suffix, not just .local
.env.local*
*.env.backup
*.staging-backup
