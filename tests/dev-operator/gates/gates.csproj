<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The development-only operator sign-in must be impossible in production
    (Mr. Singh, 24 Sept 2026). Every decision about whether it may exist
    lives in apps/api/Modules/Auth/Endpoints/DevOperatorGate.cs; this compiles
    THAT file and asks it every question production could ask.

    Same choices as tests/mask: the production file is LINKED, no test
    framework (`dotnet run`, read the last line), not in any solution, never
    published, not in CI (a workflow change goes to the CTO). Sdk.Web only for
    the framework reference the API itself compiles against.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TatvaOS.Tests.DevOperator</RootNamespace>
    <AssemblyName>dev-operator-gates</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The production file itself. Not a copy. -->
    <Compile Include="../../../apps/api/Modules/Auth/Endpoints/DevOperatorGate.cs"
             Link="DevOperatorGate.cs" />
  </ItemGroup>

</Project>
