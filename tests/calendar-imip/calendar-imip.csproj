<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ═══════════════════════════════════════════════════════════════════════
     THE iMIP TESTS.

     Calendar invitations have to be right the FIRST time they reach a real
     recipient, because the failure mode is silent and asymmetric: Gmail is
     forgiving and Outlook is not, so a payload that renders buttons here can
     be rejected outright there, and nobody finds out until a customer says
     "the invitation didn't come through" about a meeting they missed.

     Three things this project exists to pin, all of them cheap to get wrong
     and invisible when you do:

       FOLDING IS OCTETS, NOT CHARACTERS. RFC 5545 caps a line at 75 octets.
       Devanagari is three bytes a character, so a perfectly ordinary Hindi
       meeting title breaks the object — for our customers, not for us.

       TEXT ESCAPING is backslash, semicolon, comma, newline — and NOT the
       colon. An unescaped comma truncates a LOCATION at the comma, because
       comma is the list separator.

       CRLF EVERYWHERE. Bare LF is accepted by Gmail and rejected by
       Exchange: it works in testing and fails at the customer who bought
       the product for Outlook.

     Same two choices as tests/connect-wire, for the same reasons:

     1. Imip.cs and CalendarEntities.cs are LINKED, not copied. These tests
        compile the exact files that run in production; a copy drifts and
        goes on passing against code nobody ships.

     2. No test framework. A console app with an exit code, so there is no
        test-runner to configure and `dotnet run` tells you everything.

     THE NO-RESTORE PROPERTY WAS SPENT ON PURPOSE, 19 August 2026. This
     project used to reference no packages at all and the header said so.
     Testing the REAL carriage means linking Mail's InvitationBody and Core's
     ImipStructure, and both need MimeKit - so it now needs one package.

     Said here rather than quietly deleted, because a header that still
     boasted "runs on a machine with no network" would be a lie somebody
     eventually relies on. What was actually given up is narrower than the
     old claim: MimeKit is already an API dependency, so any machine that has
     built this repo has it cached. The loss is "runs on a machine that has
     never built the API".

     Bought with it: the alternative is testing a message the TEST assembled,
     which proves the test correct and the shipping code untested.
    ═══════════════════════════════════════════════════════════════════════
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TatvaOS.Tests.CalendarImip</RootNamespace>
    <AssemblyName>calendar-imip-test</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the API's version. A test that passes against a different
         MimeKit than production ships is a test about a library nobody runs. -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The production files themselves. Not copies. InvitationBody is MAIL'S
         file, linked so the structural test exercises the carriage that
         actually ships rather than one assembled here. -->
    <Compile Include="../../apps/api/Modules/Calendar/Imip.cs" Link="Imip.cs" />
    <Compile Include="../../apps/api/Modules/Calendar/ImipStructure.cs" Link="ImipStructure.cs" />
    <Compile Include="../../apps/api/Modules/Mail/InvitationBody.cs" Link="InvitationBody.cs" />
    <Compile Include="../../apps/api/Shared/Data/CalendarEntities.cs" Link="CalendarEntities.cs" />
  </ItemGroup>

</Project>
