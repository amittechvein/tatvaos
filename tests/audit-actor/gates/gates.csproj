<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    An operator's action must name the operator (Mr. Singh, 29 Sept 2026).
    Three production files decide that, and this compiles THOSE files:

      Shared/Auth/SignedIn.cs          who is signed in, from the token
      Shared/ClientIp.cs               where the request came from
      Modules/Admin/AuditActorGuard.cs whether the line may be written

    Same choices as tests/dev-operator/gates: the production files are LINKED,
    no test framework (`dotnet run`, read the last line), not in any solution,
    never published, not in CI (a workflow change goes to the CTO).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TatvaOS.Tests.AuditActor</RootNamespace>
    <AssemblyName>audit-actor-gates</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The production files themselves. Not copies. -->
    <Compile Include="../../../apps/api/Shared/Auth/SignedIn.cs" Link="SignedIn.cs" />
    <Compile Include="../../../apps/api/Shared/ClientIp.cs" Link="ClientIp.cs" />
    <Compile Include="../../../apps/api/Modules/Admin/AuditActorGuard.cs" Link="AuditActorGuard.cs" />
  </ItemGroup>

</Project>
