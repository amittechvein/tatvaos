<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ai.mail.organisations: which organisations may use TatvaOS AI in Mail.
    EMPTY MEANS NONE (Mr. Singh, 29 Sept 2026): the same "empty means
    everyone" shape he ruled against for recording sharing's test list.
    Compiles the production file (LINKED, not copied) and asks it every
    question. Same choices as tests/dev-operator/gates: no test framework
    (`dotnet run`, read the last line), not in any solution, not in CI.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TatvaOS.Tests.MailAiList</RootNamespace>
    <AssemblyName>mail-ai-list</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../apps/api/Shared/Ai/MailAiOrganisationList.cs" Link="MailAiOrganisationList.cs" />
  </ItemGroup>

</Project>
