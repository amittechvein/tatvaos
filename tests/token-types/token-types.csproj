<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ═══════════════════════════════════════════════════════════════════════
     EVERY TOKEN TYPE CARRIES ITS TYPE, AND EVERY VERIFIER CHECKS FOR ITS OWN.

     Jwt:SigningKey signs access tokens and Connect download tickets, and is
     MFA's default key. Until 1 Oct 2026 the three were told apart only by
     their formats. Mr. Singh: "make the distinction structural, not
     observed." This runs the three REAL issuers and verifiers from the API
     with one shared key and feeds every token to every verifier - plus
     tokens correctly signed with that key but carrying no type, or another
     type, which is what a fourth use of the key would look like.

     References the API project (as tests/tenant-filters does), so it tests
     the production classes, not copies. No test framework: `dotnet run`,
     read the last line, exit 0 or 1.
    ═══════════════════════════════════════════════════════════════════════
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TatvaOS.Tests.TokenTypes</RootNamespace>
    <AssemblyName>token-types-test</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../apps/api/TatvaOS.Api.csproj" />
  </ItemGroup>

</Project>
