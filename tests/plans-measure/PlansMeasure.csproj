<Project Sdk="Microsoft.NET.Sdk">
  <!--
    "Organisations unchanged", MEASURED (Mr. Singh on PR 313, 28 Sept 2026).
    Built twice against the SAME source file: once referencing main's API
    (ApiProject=<main checkout>/apps/api/TatvaOS.Api.csproj, Side=before) and
    once referencing PR 313's (Side=after). See run.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(Side)' == 'after'">$(DefineConstants);AFTER</DefineConstants>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ApiProject)" />
  </ItemGroup>
</Project>
