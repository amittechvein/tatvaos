# ============================================================================
#  Is this recipient on a domain we host?
# ============================================================================
#
#  Used only inside the 'internal_only' restriction class. A sender that has
#  not yet verified a domain may deliver here and nowhere else.
#
#  Matches on the recipient's DOMAIN (%d), not the full address — a trial user
#  should be able to email every colleague in their organisation without each
#  mailbox needing to exist first, and without us leaking which addresses do.
#
#  Note this permits any domain WE host, not just the sender's own. Two tenants
#  on the platform emailing each other is not abuse, it costs us nothing, and
#  restricting it further would mean answering "why can I not email that
#  address" for a case nobody is harmed by.

hosts    = postgres
user     = tatvaos_mailedge
password = dev_mail_pw
dbname   = tatvaos_mail

# Same MX rule as virtual-domains.cf: a domain counts as one we host only
# when its MX points at us, or it is a platform domain we provision
# ourselves (hosted by definition). Without it an UNVERIFIED sender could be
# permitted to relay to a send-only domain (inbox at Google) as if it were
# internal -- exactly the off-platform delivery this class exists to stop.
query = SELECT 'OK'
        FROM   core.domains d
        JOIN   core.tenants t ON t.id = d.tenant_id
        WHERE  d.fqdn = '%d'
          AND  d.is_active AND (d.mx_verified_at IS NOT NULL OR d.is_platform)
          AND  t.status IN ('active', 'trial')
