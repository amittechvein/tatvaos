# Rewrite an alias to the address of the mailbox that should receive it.
# ceo@techvein.local and director@techvein.local both resolve to amit@.

hosts    = postgres
user     = tatvaos_mailedge
password = dev_mail_pw
dbname   = tatvaos_mail

query = SELECT m.address FROM mail.aliases a
        JOIN mail.mailboxes m ON m.id = a.target_mailbox_id
        JOIN core.tenants   t ON t.id = a.tenant_id
        WHERE a.address = '%s'
          AND a.is_active = true
          AND m.is_active = true
          AND t.status = 'active'
