# Does this exact recipient address exist and is it deliverable?
# This lookup is what lets Postfix answer 550 during the SMTP transaction
# instead of accepting the message and generating a bounce later.

hosts    = postgres
user     = tatvaos_mailedge
password = dev_mail_pw
dbname   = tatvaos_mail

query = SELECT 1 FROM mail.mailboxes m
        JOIN core.tenants t ON t.id = m.tenant_id
        WHERE m.address = '%s'
          AND m.is_active = true
          AND t.status = 'active'
