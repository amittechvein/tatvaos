# ============================================================================
#  Postfix master.cf  -  TatvaOS Mail local development
# ============================================================================
#  service      type  private unpriv  chroot  wakeup  maxproc  command + args
#                     (yes)   (yes)   (no)    (never) (100)
# ============================================================================

# ----------------------------------------------------------------------------
# Inbound SMTP :25  -  "the internet" in local dev (host port 2525)
#
#  Inherits smtpd_recipient_restrictions from main.cf, which deliberately does
#  NOT begin with permit_mynetworks. This port must never trust its client -
#  it accepts mail addressed to us and refuses everything else.
# ----------------------------------------------------------------------------
smtp      inet  n       -       n       -       -       smtpd
    -o smtpd_client_restrictions=

# ----------------------------------------------------------------------------
# Submission :587  -  authenticated client send (host port 5870)
#
#  THIS is where client trust belongs, and only here. Relaying to external
#  domains is the entire purpose of a submission port, so permit_mynetworks
#  is correct at this position and dangerous on port 25.
#
#  Production requires TLS and SASL here. Local dev accepts unauthenticated
#  submission from mynetworks so swaks and the API can send without a
#  certificate. These three -o lines must NOT be copied to production.
# ----------------------------------------------------------------------------
submission inet n       -       n       -       -       smtpd
    -o syslog_name=postfix/submission
    -o smtpd_tls_security_level=none
    -o smtpd_sasl_auth_enable=no
    -o smtpd_client_restrictions=permit_mynetworks,reject
    -o smtpd_recipient_restrictions=permit_mynetworks,reject_unauth_destination,reject

# ----------------------------------------------------------------------------
# Standard internal services
# ----------------------------------------------------------------------------
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
