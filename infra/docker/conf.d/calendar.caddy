# ============================================================================
#  TatvaOS Calendar — calendar.tatvaos.com
# ============================================================================
#
#  The address exists BEFORE the product does, deliberately: DNS and the
#  certificate want warming up, and a customer who tries the obvious hostname
#  should meet an honest "not yet" rather than a browser error that looks like
#  our infrastructure is broken.
#
#  /calendar renders the coming-soon page today. When the product ships,
#  nothing here changes.
#
#  Requires CALENDAR_DOMAIN in the production environment file — see the
#  warning in account.caddy about what a missing variable does.
# ============================================================================

{$CALENDAR_DOMAIN} {
    encode zstd gzip

    # Send every other product's paths to their own door — see the
    # product_doors snippet in the main Caddyfile for why and for the
    # self-redirect guard that makes this safe to import everywhere.
    import product_doors

    handle /api/* {
        reverse_proxy api:8080
    }

    redir / /calendar

    @consolepaths path /org /org/* /admin /admin/* /signup /signup/*
    redir @consolepaths https://{$SITE_DOMAIN}{uri}

    handle {
        reverse_proxy web:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
