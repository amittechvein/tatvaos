# Testing environment. Copy to .env on the TESTING server.
# Never commit the filled-in version.

SITE_DOMAIN=staging.tatvaos.com

# One host serves everything on staging, so Mail lives at /mail on the same
# origin and the cookies stay host-only. Widening them here would buy nothing
# and would put the refresh cookie on every staging subdomain.
MAIL_DOMAIN=
AUTH_COOKIE_DOMAIN=
PUBLIC_API_URL=https://staging.tatvaos.com/api
JWT_ISSUER=https://staging.tatvaos.com

POSTGRES_DB=tatvaos_mail
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand
APP_DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand
JWT_SIGNING_KEY=CHANGE_ME_at_least_32_chars

# Testing never reaches the real internet. Do not set RELAY_HOST here.

# ----------------------------------------------------------------------------
# First sign-in.
#
# Set these ONCE, deploy, sign in, change the password, then blank them again.
# The account is only created when no super admin exists, so leaving them set
# does not reset anything - but they end up in shell history and deploy logs,
# which is reason enough to remove them.
# ----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
