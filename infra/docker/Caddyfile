# TatvaOS — reverse proxy
#
# Caddy over Nginx for one reason: automatic TLS. Certificates are obtained
# and renewed with no cron job, no certbot, and no 3am expiry incident.
# {$SITE_DOMAIN} comes from the environment file, so the SAME Caddyfile
# serves staging and production.

# ============================================================================
#  EVERY DOOR SENDS EVERY PRODUCT HOME — the product_doors snippet.
#
#  The app's product switcher uses RELATIVE links (/connect/new, /mail/inbox),
#  and every front door proxies every path to the same web container. So a
#  person on mail.tatvaos.com who clicked Connect STAYED on mail.tatvaos.com
#  — the page rendered, the address was wrong, and every link they copied or
#  bookmarked from then on carried the wrong host. Connect reported it as
#  "links pointing at the wrong host", which is exactly what it was.
#
#  Fixing it in the WEB APP would mean the shared nav learning six hostnames
#  and every future link author remembering the rule. Fixing it HERE means
#  the doors themselves are the rule: whichever host a product path arrives
#  on, it is redirected to that product's own door, exactly as /org and
#  /admin already redirect to Core in every fragment.
#
#  THE `not host` GUARD IS LOAD-BEARING. Without it, mail.tatvaos.com would
#  redirect /mail/* to itself, forever. With it, each door passes its own
#  product through and redirects everyone else's — so ONE snippet is safe to
#  import from EVERY site block, which is what keeps the matrix from being
#  maintained by hand in seven files.
#
#  Used only from the production conf.d fragments (and the core/ fragment),
#  which exist only where their domain variables are set — a snippet that is
#  defined but never imported costs staging nothing.
# ============================================================================
(product_doors) {
    @to_mail {
        path /mail /mail/*
        not host {$MAIL_DOMAIN}
    }
    redir @to_mail https://{$MAIL_DOMAIN}{uri}

    @to_connect {
        path /connect /connect/*
        not host {$CONNECT_DOMAIN}
    }
    redir @to_connect https://{$CONNECT_DOMAIN}{uri}

    @to_space {
        path /space /space/*
        not host {$SPACE_DOMAIN}
    }
    redir @to_space https://{$SPACE_DOMAIN}{uri}

    @to_family {
        path /family /family/*
        not host {$FAMILY_DOMAIN}
    }
    redir @to_family https://{$FAMILY_DOMAIN}{uri}

    @to_calendar {
        path /calendar /calendar/*
        not host {$CALENDAR_DOMAIN}
    }
    redir @to_calendar https://{$CALENDAR_DOMAIN}{uri}

    @to_account {
        path /account /account/*
        not host {$ACCOUNT_DOMAIN}
    }
    redir @to_account https://{$ACCOUNT_DOMAIN}{uri}
}

{$SITE_DOMAIN} {
    encode zstd gzip

    # Host discipline, production only. The conf.d directory is mounted by the
    # production overlay; on staging this import matches nothing and one host
    # keeps serving everything. The subdirectory matters: the TOP-level import
    # below loads whole site blocks, and this file is a fragment that belongs
    # INSIDE this one.
    import /etc/caddy/conf.d/core/*.caddy

    handle /api/* {
        reverse_proxy api:8080
    }

    handle /health* {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# TatvaOS Mail gets its own front door (mail.tatvaos.com) in production only.
#
# It lives in an imported fragment rather than inline with a {$MAIL_DOMAIN}
# placeholder, because on staging that variable is empty — and an empty site
# address makes Caddy refuse the whole config and exit, which presents as an
# endless restart loop with every other service healthy. An import that
# matches no files is simply a no-op.
import /etc/caddy/conf.d/*.caddy

# The mail-catcher.* and webmail.* blocks that used to sit here are GONE, and
# should not come back in this file. They were testing-only, "unreachable in
# production because the hostnames do not resolve" — except a wildcard DNS
# record on the apex made every subdomain resolve, at which point production
# Caddy was obtaining real TLS certificates for two dead doors and internet
# scanners were probing them around the clock. A future staging box that wants
# them should carry them in its own conf.d fragment, mounted by its own
# overlay, where production can never see them.
