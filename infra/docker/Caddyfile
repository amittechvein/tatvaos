# TatvaOS — reverse proxy
#
# Caddy over Nginx for one reason: automatic TLS. Certificates are obtained
# and renewed with no cron job, no certbot, and no 3am expiry incident.
# {$SITE_DOMAIN} comes from the environment file, so the SAME Caddyfile
# serves staging and production.

{$SITE_DOMAIN} {
    encode zstd gzip

    # Host discipline, production only. The conf.d directory is mounted by the
    # production overlay; on staging this import matches nothing and one host
    # keeps serving everything. The subdirectory matters: the TOP-level import
    # below loads whole site blocks, and this file is a fragment that belongs
    # INSIDE this one.
    import /etc/caddy/conf.d/core/*.caddy

    handle /api/* {
        reverse_proxy api:8080
    }

    handle /health* {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# TatvaOS Mail gets its own front door (mail.tatvaos.com) in production only.
#
# It lives in an imported fragment rather than inline with a {$MAIL_DOMAIN}
# placeholder, because on staging that variable is empty — and an empty site
# address makes Caddy refuse the whole config and exit, which presents as an
# endless restart loop with every other service healthy. An import that
# matches no files is simply a no-op.
import /etc/caddy/conf.d/*.caddy

# The mail-catcher.* and webmail.* blocks that used to sit here are GONE, and
# should not come back in this file. They were testing-only, "unreachable in
# production because the hostnames do not resolve" — except a wildcard DNS
# record on the apex made every subdomain resolve, at which point production
# Caddy was obtaining real TLS certificates for two dead doors and internet
# scanners were probing them around the clock. A future staging box that wants
# them should carry them in its own conf.d fragment, mounted by its own
# overlay, where production can never see them.
