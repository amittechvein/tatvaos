# ============================================================================
#  TatvaOS Mail — mail.tatvaos.com
# ============================================================================
#
#  Its own front door onto the same web container, so the product has the
#  address customers expect (mail.google.com, not google.com/mail) without a
#  second deployment to keep in step.
#
#  THIS IS NOT THE MAIL EXCHANGER. That is mx.tatvaos.com, and it is Postfix.
#  An MX record pointing here would send customer mail to a web server, where
#  it would be refused — every message bounced, and the cause not obvious.
#
#  Mounted by the PRODUCTION overlay only. Staging serves everything from one
#  host, so this file is absent there and the import matches nothing.
# ============================================================================

{$MAIL_DOMAIN} {
    encode zstd gzip

    # Send every other product's paths to their own door — see the
    # product_doors snippet in the main Caddyfile for why and for the
    # self-redirect guard that makes this safe to import everywhere.
    import /etc/caddy/conf.d/core/product-doors.caddy

    handle /api/* {
        reverse_proxy api:8080
    }

    # Landing on the host should land in the inbox. Without this, mail.
    # serves the Core dashboard and the separate address means nothing.
    redir / /mail/inbox

    # The mirror of core's /mail redirect: administration lives on Core and
    # nowhere else. Sign-in and /account stay valid on both hosts — a person
    # signing in ON mail should not be bounced through another domain first.
    @consolepaths path /org /org/* /admin /admin/* /signup /signup/*
    redir @consolepaths https://{$SITE_DOMAIN}{uri}

    handle {
        reverse_proxy web:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
