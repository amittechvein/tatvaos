# ============================================================================
#  The public website — tatvaos.com and www.tatvaos.com
# ============================================================================
#
#  Static files, nothing else. No API, no web container, no cookies: the
#  marketing page must keep answering when everything behind it is being
#  redeployed, and it must never be a way into a signed-in product. The
#  product doors live on their own hosts; this one links to them.
#
#  The files come from apps/website/, mounted read-only at /srv/website by
#  docker-compose.base.yml. deploy.sh's `git reset --hard` replaces them in
#  place; file_server reads by name, so a replaced file is the new file — the
#  same reason the Caddyfile itself is mounted as a directory.
#
#  www is a redirect, not a second copy. One canonical address for search
#  engines and for the certificate; the redirect is permanent (308) so the
#  method and body survive, not that anything here takes a body.
#
#  Requires WEBSITE_DOMAIN in the production environment file AND in the caddy
#  environment list in docker-compose.base.yml. Leaving either unset while
#  this file is mounted makes Caddy reject the whole config and restart
#  forever — the failure family.caddy's comment describes, and it takes every
#  product down, not just this page.
# ============================================================================

{$WEBSITE_DOMAIN} {
    encode zstd gzip
    root * /srv/website
    file_server

    # Screenshots and logos are content-addressed by nothing, so they are
    # cached briefly rather than forever: a replaced screenshot must show up
    # within the hour, and a day-old cache on a marketing image costs nothing.
    @assets path /shots/* /brand/*
    header @assets Cache-Control "public, max-age=3600"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

www.{$WEBSITE_DOMAIN} {
    redir https://{$WEBSITE_DOMAIN}{uri} 308
}
