# ============================================================================
#  EVERY DOOR SENDS EVERY PRODUCT HOME.
#
#  The product switcher uses RELATIVE links and every door proxies every path,
#  so a person on mail.tatvaos.com who clicked Connect stayed on the mail
#  host — page fine, address wrong, every copied link wrong from then on.
#
#  This file is imported BY PATH into every product fragment, and the core/
#  glob pulls it into the SITE_DOMAIN block. It is NOT a snippet: snippets do
#  not survive nested imports, which the first validate proved.
#
#  THE `not host` GUARD IS LOAD-BEARING: without it each door would redirect
#  its own product to itself forever. With it, one file serves all seven
#  doors — each passes its own paths through and redirects everyone else's.
# ============================================================================
@to_mail {
    path /mail /mail/*
    not host {$MAIL_DOMAIN}
}
redir @to_mail https://{$MAIL_DOMAIN}{uri}

@to_connect {
    path /connect /connect/*
    not host {$CONNECT_DOMAIN}
}
redir @to_connect https://{$CONNECT_DOMAIN}{uri}

@to_space {
    path /space /space/*
    not host {$SPACE_DOMAIN}
}
redir @to_space https://{$SPACE_DOMAIN}{uri}

@to_family {
    path /family /family/*
    not host {$FAMILY_DOMAIN}
}
redir @to_family https://{$FAMILY_DOMAIN}{uri}

@to_calendar {
    path /calendar /calendar/*
    not host {$CALENDAR_DOMAIN}
}
redir @to_calendar https://{$CALENDAR_DOMAIN}{uri}

@to_account {
    path /account /account/*
    not host {$ACCOUNT_DOMAIN}
}
redir @to_account https://{$ACCOUNT_DOMAIN}{uri}
