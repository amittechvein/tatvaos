# Production environment. Copy to .env on the PRODUCTION server.
# Never commit the filled-in version. Keep a copy in Bitwarden.

# TatvaOS Core — the admin console, our admin.google.com.
SITE_DOMAIN=core.tatvaos.com
PUBLIC_API_URL=https://core.tatvaos.com/api
JWT_ISSUER=https://core.tatvaos.com

# TatvaOS Mail — webmail, our mail.google.com. Served by the same web
# container; Caddy gives the product its own front door.
#
# NOT the mail exchanger. Customers publish MX 10 mx.tatvaos.com, never this
# host — keeping them apart lets webmail move without touching anyone's DNS.
MAIL_DOMAIN=mail.tatvaos.com

# TatvaOS Family — the address book. Same web container, its own front door.
#
# This was missing from this file for weeks while being set by hand on the
# server, so a box provisioned from this example would mount family.caddy with
# no variable behind it — which makes Caddy reject the ENTIRE config and
# restart-loop, taking Core and Mail down as well. Every conf.d site file needs
# its variable listed here.
FAMILY_DOMAIN=family.tatvaos.com

# TatvaOS Space — file storage. Set this BEFORE space.caddy is deployed; see
# the note above for what happens in the other order.
SPACE_DOMAIN=space.tatvaos.com

# TatvaOS Account — the personal hub. Its own address because password,
# devices and storage belong to the PERSON, not to whichever product they
# happened to open. /account on the other hosts keeps working.
ACCOUNT_DOMAIN=account.tatvaos.com

# Not built yet, both of them. The addresses exist so DNS and certificates are
# warm and the obvious hostname meets an honest "not yet" instead of a browser
# error — but the variable must be set the moment the conf.d file is mounted,
# or Caddy rejects everything.
CALENDAR_DOMAIN=calendar.tatvaos.com
# TatvaOS Connect — meetings. Our Google Meet.
CONNECT_DOMAIN=connect.tatvaos.com

# Scopes the auth cookies to the whole domain so one sign-in covers Core and
# Mail. Leave EMPTY unless every host under this domain is ours: the refresh
# cookie is sent to all of them.
AUTH_COOKIE_DOMAIN=.tatvaos.com

# Read by the Postfix and Dovecot entrypoints. Anything other than "local"
# makes them refuse to start on the development password.
# What Postfix announces in HELO, and what mydomain is derived from.
# MUST equal the PTR record for this server's IP — receivers check that the
# reverse lookup resolves forward to the same address, and a mismatch costs
# deliverability silently rather than producing an error we can see.
MAIL_HOSTNAME=mx.tatvaos.com

TATVAOS_ENV=production

POSTGRES_DB=tatvaos_mail
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_different_from_testing
APP_DB_PASSWORD=CHANGE_ME_different_from_testing
# The mail edge — Postfix and Dovecot. They render their config from this at
# container start; the schema rotates the tatvaos_mailedge role from the same
# value. Both halves must change together, which is why there is one variable.
# Leaving it unset makes Postfix and Dovecot refuse to start rather than fall
# back to the development password.
MAILEDGE_DB_PASSWORD=CHANGE_ME_different_from_the_app_password
REDIS_PASSWORD=CHANGE_ME_different_from_testing
JWT_SIGNING_KEY=CHANGE_ME_different_from_testing

# Empty = observe only (logs "would-defer" lines, delivers everything).
# "enforce" = over-quota mailboxes 4xx-defer incoming mail until space is
# freed. Flip only after the observe logs show no false positives.
MAIL_QUOTA_ENFORCEMENT=enforce

# Relay-first while IPs warm up. Empty means send directly.
RELAY_HOST=
RELAY_USER=
RELAY_PASSWORD=
