# ============================================================================
#  Line endings
# ============================================================================
#
#  This is not a tidiness setting. Everything in this repo that runs inside a
#  Linux container breaks if Git hands it CRLF on checkout:
#
#    *.sh   -> "#!/usr/bin/env bash\r" -> "bad interpreter: No such file"
#    *.cf   -> "hosts = postgres\r"    -> Postfix tries to resolve "postgres\r"
#    *.conf -> Dovecot parse errors on invisible characters
#
#  So: LF everywhere, except the few file types Windows genuinely owns.
# ============================================================================

# Default: normalise to LF in the repo and on checkout
* text=auto eol=lf

# ----------------------------------------------------------------------------
# MUST be LF - these run in containers or on Linux hosts
# ----------------------------------------------------------------------------
*.sh            text eol=lf
*.bash          text eol=lf
*.cf            text eol=lf
*.conf          text eol=lf
*.conf.ext      text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
Makefile        text eol=lf
.env.example    text eol=lf
entrypoint.sh   text eol=lf

# Postfix and Dovecot config without an extension
main.cf         text eol=lf
master.cf       text eol=lf

# ----------------------------------------------------------------------------
# CRLF - Windows-native, never executed on Linux
# ----------------------------------------------------------------------------
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# ----------------------------------------------------------------------------
# Source and docs - LF
# ----------------------------------------------------------------------------
*.cs            text eol=lf
*.csproj        text eol=lf
*.sln           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.md            text eol=lf

# ----------------------------------------------------------------------------
# Binary - never touch
# ----------------------------------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.p8            binary
*.pem           binary
*.keystore      binary
*.jks           binary

# ----------------------------------------------------------------------------
# Generated - collapse in diffs and exclude from language stats
# ----------------------------------------------------------------------------
packages/api-client/**  linguist-generated=true
packages/types/**       linguist-generated=true
pnpm-lock.yaml          linguist-generated=true -diff
