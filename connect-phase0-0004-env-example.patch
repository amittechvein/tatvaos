diff --git a/infra/docker/.env.production.example b/infra/docker/.env.production.example
index 7106edd..5f9d386 100644
--- a/infra/docker/.env.production.example
+++ b/infra/docker/.env.production.example
@@ -39,6 +39,23 @@ CALENDAR_DOMAIN=calendar.tatvaos.com
 # TatvaOS Connect — meetings. Our Google Meet.
 CONNECT_DOMAIN=connect.tatvaos.com
 
+# Connect's media path (Phase 0). LIVEKIT_* is the credential pair the media
+# server boots with and the API will later mint room-scoped tokens with; a
+# browser only ever receives those short-lived JWTs, never this pair. TURN_*
+# is coturn's static relay credential. Generate real values:
+#   LIVEKIT_API_KEY=$(openssl rand -hex 8)
+#   LIVEKIT_API_SECRET=$(openssl rand -base64 32)
+#   TURN_PASSWORD=$(openssl rand -base64 24)
+# TURN_EXTERNAL_IP is this box's public IPv4 — TURN writes it into relay
+# candidates, and a wrong value fails at call time, not at start. Set ALL of
+# these in .env BEFORE deploying the commit that adds the services: compose
+# refuses to start without them, which beats starting wrong.
+LIVEKIT_API_KEY=CHANGE_ME
+LIVEKIT_API_SECRET=CHANGE_ME
+TURN_USERNAME=tatvaos
+TURN_PASSWORD=CHANGE_ME
+TURN_EXTERNAL_IP=CHANGE_ME
+
 # Scopes the auth cookies to the whole domain so one sign-in covers Core and
 # Mail. Leave EMPTY unless every host under this domain is ours: the refresh
 # cookie is sent to all of them.
